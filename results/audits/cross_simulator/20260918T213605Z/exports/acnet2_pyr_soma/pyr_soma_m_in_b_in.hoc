load_file("subiter.hoc")

begintemplate pyr_soma_m_in_b_in

public init, topol, basic_shape, subsets, geom, memb
public x, y, z, position


//  Some methods for referencing the cells

public toString, netInfo, set_initial_v, set_initial_ion_properties, synlist


// Section: soma, id: soma, parent: $s.parent
create soma
public soma

// Group: {name=soma_group, groups=[], sections=[soma]}
objref soma_group
// Group: {name=all, sections=[soma]}
objref all

objref synlist

proc init() {
    topol()
    geom_nseg()
    subsets()
    subsets_inhomogeneous()
    biophys()
    biophys_inhomogeneous()
    synlist = new List()
    x = y = z = 0

}

proc set_initial_v() {
    // Taken from the initMembPotential value
    forsec all v = -65.0  // units: mV
}


proc set_initial_ion_properties() {
    // From species
    // Ion: ca on group: all, with concentration model: Ca_conc
    forsec all {
        cai = 5.0E-5  // units: mM
        cao = 3.0  // units: mM
    }
}


proc topol() {
    basic_shape()

}


proc basic_shape() {

    // Section: soma, id: soma, parent: $s.parent (entry count 0/100)
    soma { pt3dclear() }
    soma { pt3dadd( 0.0, 0.0, 0.0, 23.0 ) }
    soma { pt3dadd( 0.0, 17.0, 0.0, 23.0 ) }

}


proc subsets() { local i

    // Group: {name=soma_group, groups=[], sections=[soma]}
    soma_group = new SectionList()
    soma soma_group.append()

    // Group: {name=all, sections=[soma]}
    all = new SectionList()
    soma all.append()

}


proc subsets_inhomogeneous() {
}

proc biophys() {

    // Specific capacitance
    forsec all cm = 2.84  // units: uF/cm2

    // Specific axial resistance/resistivity
    forsec all Ra = 200.0  // units: ohm cm

    // Channel densities
    forsec soma_group {
        insert Ca_pyr
        gmax_Ca_pyr = 0.01  // units: S cm-2
        eca = 80.0  // units: mV
    }
    forsec soma_group {
        insert Kahp_pyr
        gmax_Kahp_pyr = 0.0025  // units: S cm-2
        ek = -75.0  // units: mV
    }
    forsec soma_group {
        insert Kdr_pyr
        gmax_Kdr_pyr = 0.08  // units: S cm-2
        ek = -75.0  // units: mV
    }
    forsec all {
        insert LeakConductance_pyr
        gmax_LeakConductance_pyr = 1.420051E-4  // units: S cm-2
        e_LeakConductance_pyr = -66.0  // units: mV
    }
    forsec soma_group {
        insert Na_pyr
        gmax_Na_pyr = 0.12  // units: S cm-2
        ena = 55.0  // units: mV
    }

    // Concentration models for species
    // Ion: ca on group: all, with concentration model: Ca_conc
    forsec all {
        insert Ca_conc
    }

}

func H() { // Heaviside function
    if ($1>=0) return 1
    if ($1==0) return 0.5
    return 0
}

proc biophys_inhomogeneous() {
}

proc geom_nseg() {
    // All sections not mentioned here have nseg = 1
}


proc position() { local i
    forsec all {
        for i = 0, n3d()-1 {
            pt3dchange(i, $1+x3d(i), $2+y3d(i), $3+z3d(i), diam3d(i))
        }
    }
    x = $1  y = $2  z = $3
}


endtemplate pyr_soma_m_in_b_in



load_file("subiter.hoc")

begintemplate cell

public init, topol, basic_shape, subsets, geom, memb
public x, y, z, position


//  Some methods for referencing the cells

public toString, netInfo, set_initial_v, set_initial_ion_properties, synlist


// Section: soma, id: soma, parent: $s.parent
create soma
public soma

// Group: {name=soma_group, groups=[], sections=[soma]}
objref soma_group
// Group: {name=all, sections=[soma]}
objref all

objref synlist

proc init() {
    topol()
    geom_nseg()
    subsets()
    subsets_inhomogeneous()
    biophys()
    biophys_inhomogeneous()
    synlist = new List()
    x = y = z = 0

}

proc set_initial_v() {
    // Taken from the initMembPotential value
    forsec all v = -65.0  // units: mV
}


proc set_initial_ion_properties() {
    // From species
}


proc topol() {
    basic_shape()

}


proc basic_shape() {

    // Section: soma, id: soma, parent: $s.parent (entry count 0/100)
    soma { pt3dclear() }
    soma { pt3dadd( 0.0, 0.0, 0.0, 29.7838 ) }
    soma { pt3dadd( 0.0, 0.0, 9.26604, 29.7838 ) }

}


proc subsets() { local i

    // Group: {name=soma_group, groups=[], sections=[soma]}
    soma_group = new SectionList()
    soma soma_group.append()

    // Group: {name=all, sections=[soma]}
    all = new SectionList()
    soma all.append()

}


proc subsets_inhomogeneous() {
}

proc biophys() {

    // Specific capacitance
    forsec all cm = 1.0  // units: uF/cm2

    // Specific axial resistance/resistivity

    // Channel densities
    forsec all {
        insert na
        gmax_na = 0.099999994  // units: S cm-2
        ena = 60.0  // units: mV
    }
    forsec all {
        insert kv
        gmax_kv = 0.01  // units: S cm-2
        ek = -90.0  // units: mV
    }
    forsec all {
        insert km
        gmax_km = 2.2E-4  // units: S cm-2
        ek = -90.0  // units: mV
    }
    forsec all {
        insert ca
        gmax_ca = 5.0E-5  // units: S cm-2
        eca = 140.0  // units: mV
    }
    forsec all {
        insert kca
        gmax_kca = 2.9999999E-4  // units: S cm-2
        ek = -90.0  // units: mV
    }
    forsec all {
        insert it
        gmax_it = 2.9999999E-4  // units: S cm-2
        eca = 140.0  // units: mV
    }
    forsec all {
        insert pas_nml2
        gmax_pas_nml2 = 1.4285E-4  // units: S cm-2
        e_pas_nml2 = -75.0  // units: mV
    }

    // Concentration models for species

}

func H() { // Heaviside function
    if ($1>=0) return 1
    if ($1==0) return 0.5
    return 0
}

proc biophys_inhomogeneous() {
}

proc geom_nseg() {
    // All sections not mentioned here have nseg = 1
}


proc position() { local i
    forsec all {
        for i = 0, n3d()-1 {
            pt3dchange(i, $1+x3d(i), $2+y3d(i), $3+z3d(i), diam3d(i))
        }
    }
    x = $1  y = $2  z = $3
}


endtemplate cell



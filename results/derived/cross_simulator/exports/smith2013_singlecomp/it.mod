    (nF) = (nanofarad)
    (molar) = (1/liter)
    (kHz) = (kilohertz)
    (mM) = (millimolar)
    (um) = (micrometer)
    (umol) = (micromole)
    (pC) = (picocoulomb)
    (S) = (siemens)
    
}

PARAMETER {
    
    gmax = 0  (S/cm2)                       : Will be changed when ion channel mechanism placed on cell!
    
    conductance = 1.0E-5 (uS)              : was: 1.0E-11 (conductance)
    m_instances = 2                        : was: 2.0 (none)
    m_timeCourse_TIME_SCALE = 1 (ms)       : was: 0.001 (time)
    m_timeCourse_am = 3                    : was: 3.0 (none)
    m_timeCourse_vm1 = 25 (mV)             : was: 0.025 (voltage)
    m_timeCourse_wm1 = 20 (mV)             : was: 0.02 (voltage)
    m_timeCourse_vm2 = 100 (mV)            : was: 0.1 (voltage)
    m_timeCourse_wm2 = 15 (mV)             : was: 0.015 (voltage)
    m_steadyState_rate = 1                 : was: 1.0 (none)
    m_steadyState_midpoint = -50 (mV)      : was: -0.05 (voltage)
    m_steadyState_scale = 7.4 (mV)         : was: 0.0074 (voltage)
    h_instances = 1                        : was: 1.0 (none)
    h_timeCourse_TIME_SCALE = 1 (ms)       : was: 0.001 (time)
    h_timeCourse_ah = 85                   : was: 85.0 (none)
    h_timeCourse_vh1 = 46 (mV)             : was: 0.046 (voltage)
    h_timeCourse_wh1 = 4 (mV)              : was: 0.004 (voltage)
    h_timeCourse_vh2 = 405 (mV)            : was: 0.405 (voltage)
    h_timeCourse_wh2 = 50 (mV)             : was: 0.05 (voltage)
    h_steadyState_rate = 1                 : was: 1.0 (none)
    h_steadyState_midpoint = -78 (mV)      : was: -0.078 (voltage)
    h_steadyState_scale = -5 (mV)          : was: -0.005 (voltage)
}

ASSIGNED {
    
    gion   (S/cm2)                          : Transient conductance density of the channel? Standard Assigned variables with ionChannel
    v (mV)
    celsius (degC)
    temperature (K)
    eca (mV)
    ica (mA/cm2)
    i__it (mA/cm2)
    
    m_timeCourse_t (ms)                     : derived variable
    m_steadyState_x                         : derived variable
    m_rateScale                             : derived variable
